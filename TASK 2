#include <stdio.h>
#include <string.h>

struct parcel
{
    int id;
    float weight;

    struct
    {
        char city[20];
        int pincode;
    } to;

    struct
    {
        int day;
        int month;
        int year;
    } booked;
};

void print_parcel(const struct parcel *p)
{
    printf("%d %.1f kg %s-%d %02d/%02d/%04d\n",
           p->id,
           p->weight,
           p->to.city,
           p->to.pincode,
           p->booked.day,
           p->booked.month,
           p->booked.year);
}

void sort_by_weight(struct parcel p[], int n)
{
    int i, j, min;
    struct parcel temp;

    for (i = 0; i < n - 1; i++)
    {
        min = i;

        for (j = i + 1; j < n; j++)
        {
            if (p[j].weight < p[min].weight)
            {
                min = j;
            }
        }

        if (min != i)
        {
            temp = p[i];
            p[i] = p[min];
            p[min] = temp;
        }
    }
}

void search_by_city(struct parcel p[], int n, char city[])
{
    int i, found = 0;

    printf("\nParcels delivered to %s:\n", city);

    for (i = 0; i < n; i++)
    {
        if (strcmp(p[i].to.city, city) == 0)
        {
            print_parcel(&p[i]);
            found = 1;
        }
    }

    if (!found)
    {
        printf("No parcels found.\n");
    }
}

int main(void)
{
    struct parcel list[3] =
    {
        {501, 4.5f, {"Madurai", 625001}, {12, 10, 2026}},
        {502, 1.2f, {"Chennai", 600077}, {12, 10, 2026}},
        {503, 2.8f, {"Coimbatore", 641001}, {13, 10, 2026}}
    };

    printf("Parcels sorted by weight:\n");

    sort_by_weight(list, 3);

    for (int i = 0; i < 3; i++)
    {
        print_parcel(&list[i]);
    }

    search_by_city(list, 3, "Chennai");

    return 0;
}
