#include <stdio.h>

struct account
{
    int number;
    float balance;
};

void addInterest(struct account a, float rate)
{
    printf("Address inside function: %p\n", (void *)&a);

    a.balance = a.balance + a.balance * rate / 100;
}

int main(void)
{
    struct account list[3] =
    {
        {101, 5000},
        {102, 12000},
        {103, 800}
    };

    printf("Address in main: %p\n", (void *)&list[0]);

    addInterest(list[0], 4);

    return 0;
}
